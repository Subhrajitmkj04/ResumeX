# Copy this file to .env.local and paste your Gemini API key after the "=".
# .env.local is git-ignored, so the key never reaches GitHub.
GEMINI_API_KEY=

# Optional: models to try in order (falls back to the next one if a model is busy or unavailable)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
